{"entities": [{"id": "ent_1", "type": "Drug", "name": "阿美替尼", "canonical_name": "阿美替尼", "properties": {}}, {"id": "ent_2", "type": "Drug", "name": "伊曲康唑", "canonical_name": "伊曲康唑", "properties": {}}, {"id": "ent_3", "type": "Drug", "name": "利福平", "canonical_name": "利福平", "properties": {}}, {"id": "ent_4", "type": "Drug", "name": "阿帕替尼", "canonical_name": "阿帕替尼", "properties": {}}, {"id": "ent_5", "type": "DrugClass", "name": "CYP3A强抑制剂", "canonical_name": "CYP3A强抑制剂", "properties": {}}, {"id": "ent_6", "type": "DrugClass", "name": "CYP3A强诱导剂", "canonical_name": "CYP3A强诱导剂", "properties": {}}, {"id": "ent_7", "type": "DrugClass", "name": "CYP3A酶", "canonical_name": "CYP3A酶", "properties": {}}, {"id": "ent_8", "type": "DrugClass", "name": "CYP3A4酶", "canonical_name": "CYP3A4酶", "properties": {}}], "relations": [{"id": "rel_1", "type": "INTERACTS_WITH", "source_id": "ent_1", "target_id": "ent_2", "properties": {"source": "凡默谷", "chunk_index": 1030, "raw_text": "联用CYP3A强抑制剂伊曲康唑后，阿美替尼的Cmax和AUC0—t分别升高56.3%和2.38倍", "chunk_id": "1030"}}, {"id": "rel_2", "type": "INTERACTS_WITH", "source_id": "ent_1", "target_id": "ent_3", "properties": {"source": "凡默谷", "chunk_index": 1030, "raw_text": "联用CYP3A强诱导剂利福平后，阿美替尼的Cmax和AUC0—0分别降低79.3%和92.6%", "chunk_id": "1030"}}, {"id": "rel_3", "type": "IN_CLASS", "source_id": "ent_2", "target_id": "ent_5", "properties": {"source": "凡默谷", "chunk_index": 1030, "raw_text": "CYP3A强抑制剂伊曲康唑", "chunk_id": "1030"}}, {"id": "rel_4", "type": "IN_CLASS", "source_id": "ent_3", "target_id": "ent_6", "properties": {"source": "凡默谷", "chunk_index": 1030, "raw_text": "CYP3A强诱导剂利福平", "chunk_id": "1030"}}, {"id": "rel_5", "type": "IN_CLASS", "source_id": "ent_1", "target_id": "ent_7", "properties": {"source": "凡默谷", "chunk_index": 1030, "raw_text": "阿美替尼主要经CYP3A酶代谢", "chunk_id": "1030"}}, {"id": "rel_6", "type": "IN_CLASS", "source_id": "ent_4", "target_id": "ent_8", "properties": {"source": "凡默谷", "chunk_index": 1030, "raw_text": "阿帕替尼氧化代谢主要经CYP3A4酶催化", "chunk_id": "1030"}}], "record_index": 0, "chunk_index": 1030, "source": "凡默谷", "text": "。1.1.3阿美替尼[11]体外试验表明阿美替尼主 要经CYP3A酶代谢，N-去甲基阿美替尼（HAS-719)是主要代谢产物之一，与阿美替尼具有相似 的抗肿瘤活性，其人体血浆暴露量约为原形药物 的四分之一。联用CYP3A强抑制剂伊曲康唑后， 阿美替尼的Cmax和AUC0—t分别升高56.3%和2.38 倍，HAS-719的Cmax和AUQ—t分别降低86.8%和 71.8% ;联用CYP3A强诱导剂利福平后，阿美替尼 的 Cmax和 AUC0—0分别降低79.3% 和92.6%，而 HAS-719的AUQ—t也降低了72.6%，原因主要是利福平 诱导了同为CYP3A底物的代谢物HAS-719的进一 步代谢。阿美替尼药品说明书提示，在阿美替尼 治疗期间，应慎用CYP3A的强抑制剂或强诱导剂。1.1.4阿帕替尼[12—13]人体代谢研究结果表明， 阿帕替尼在人血浆中的主要代谢产物有单氧化 阿帕替尼M1-1、M1-2和M1-6以及单氧化并葡萄 糖醛酸结合代谢物M9-2,其血浆暴露量分别相当 于原形药物的59.3%、21.1%、28.3%和4.88倍。体 外人肝微粒体和重组酶试验表明，阿帕替尼氧化 代谢主要经CYP3A4酶催化"}
