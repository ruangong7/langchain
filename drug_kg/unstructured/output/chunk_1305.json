        "source_id": "ent_5",
        "target_id": "ent_6",
        "name": "索他洛尔与地尔硫卓相互作用",
        "properties": {
          "mechanism": "两者对房室传导和心室功能的影响有累加作用",
          "effect": "加重传导阻滞，进一步抑制心室功能、降低血压",
          "consequence": [
            "低血压",
            "心动过缓",
            "传导障碍",
            "心力衰竭"
          ],
          "recommendation": "应避免合用",
          "evidence": {
            "chunk_index": 1305,
            "source": "医世象",
            "text": "索他洛尔与钙通道阻滞药(如维拉帕米、地尔硫卓)合用，两者对房室传导和心室功能的影响有累加作用，合用时可加重传导阻滞，进一步抑制心室功能、降低血压，引起低血压、心动过缓、传导障碍和心力衰竭，应避免合用。文献依据：卫生部合理用药专家委员会.中国医师药师临床用药指南[M].重庆:重庆出版集团,重庆出版社,2009.478～480."
          }
        }
