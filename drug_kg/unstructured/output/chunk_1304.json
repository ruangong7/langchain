        "name": "硝苯地平与镁剂合用",
        "properties": {
          "consequences": [
            "ent_3",
            "ent_4"
          ],
          "recommendation": "合用时应密切监测血压",
          "evidence": {
            "chunk_index": 1304,
            "source": "医世象",
            "text": "硝苯地平+镁镁剂用于早产治疗时，如与本药合用可引起显著的低血压和神经肌肉阻滞。合用时应密切监测血压。"
          }
        }
