        "source_id": "ent_1",
        "target_id": "ent_2",
        "name": "阿司匹林与选择性COX-2抑制剂联合使用",
        "properties": {
          "后果": "减少阿司匹林对心血管的保护效果",
          "风险": "增加血栓栓塞事件的风险",
          "证据": {
            "chunk_index": 1288,
            "source": "北京老年医院",
            "text": "然而，由于选择性COX-2抑制剂只抑制前列环素,而不抑制血栓素A2的产生，可能会增加血栓栓塞事件的风险。因此，当小剂量阿司匹林联合使用选择性COX-2抑制剂时，可能会减少阿司匹林对心血管的保护效果。"
          }
        }
      },
