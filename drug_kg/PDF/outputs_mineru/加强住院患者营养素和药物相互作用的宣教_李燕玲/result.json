    "page_idx": 0
  },
  {
    "type": "text",
    "text": "李燕玲",
    "bbox": [
      465,
      98,
      529,
      114
    ],
    "page_idx": 0
  },
  {
    "type": "text",
    "text": "宁洱县中医医院 云南 宁洱 665100",
    "bbox": [
      324,
      115,
      670,
      131
    ],
