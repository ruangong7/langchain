  {
    "type": "text",
    "text": "四、用户可以通过以下方式可查询数据",
    "text_level": 2,
    "bbox": [
      99,
      267,
      452,
      288
    ],
    "page_idx": 1
  },
  {
    "type": "text",
    "text": "1. 某两种药物或某一类药物配伍查询",
    "bbox": [
      101,
      291,
      432,
      309
    ],
    "page_idx": 1
  },
  {
    "type": "list",
    "sub_type": "text",
    "list_items": [
      "1）按药物汉字属名输入查询",
      "2）按药品拉丁文属名输入查询",
      "3）按药物汉字拼音字头输入查询",
      "2. 某药物与其他药物配伍结果查询",
      "3. 某一药物与某一配伍结论查询"
    ],
    "bbox": [
      105,
      313,
