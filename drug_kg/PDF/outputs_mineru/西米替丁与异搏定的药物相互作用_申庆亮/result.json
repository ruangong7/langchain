    ],
    "page_idx": 1
  },
  {
    "type": "chart",
    "img_path": "images/b544acd65872ee91bd70d1d077d1c43b240f62594cd245f94e9858074ccb668c.jpg",
    "content": "| X-Axis | Y-Axis (mmol/L) |\n|---|---|\n| 4 | 1.2 |\n| 8 | 0.6 |\n| 12 | 0.3 |",
    "chart_caption": [],
    "chart_footnote": [
      "附图 扑热息痛血浆浓度与摄入后时间标准图象"
    ],
    "sub_type": "line chart",
    "bbox": [
      525,
