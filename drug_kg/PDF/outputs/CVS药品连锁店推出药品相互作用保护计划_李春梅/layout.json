                                        44,
                                        163,
                                        225,
                                        178
                                    ],
                                    "type": "text",
                                    "content": "393 枸橼酸钙较碳酸钙更易吸收"
                                }
                            ]
                        }
                    ],
                    "index": 3,
                    "level": 2
                },
                {
                    "bbox": [
                        43,
                        182,
                        246,
                        570
                    ],
                    "type": "text",
                    "angle": 0,
                    "lines": [
                        {
                            "bbox": [
                                43,
                                182,
                                246,
                                570
                            ],
                            "spans": [
                                {
                                    "bbox": [
                                        43,
                                        182,
                                        246,
                                        570
                                    ],
                                    "type": "text",
                                    "content": "美国得克萨斯大学西南医学中心的三项研究表明枸橼酸钙较碳酸钙更易于吸收，从而能够更好地预防妇女绝经早期骨质疏松的发生。三项研究中有二项研究对两种钙剂的吸收率进行了比较，另一项则对枸橼酸钙防止绝经早期骨质丢失作用与安慰剂进行了比较。由Khashayar Sakhace进行的第1项研究对以往发表的15个随机化试验进行了分析，结果发现不论空腹时或进餐时服用，枸橼酸钙比碳酸钙吸收率均高出22%~27%。由Howard Heller领导的第2项研究则对市售的两种非处方用钙剂Citracal（枸橼酸钙）和Os-Cal（碳酸钙）的吸收率进行了比较，结果认为前者有较好的生物利用度。持续了2年的第3项研究追踪观察了57例绝经早期和6例绝经中期妇女，这些受试者每天服用800mg枸橼酸钙或安慰剂。结果服用钙剂者脊柱、前臂及股骨头骨密度稳定，防止了骨质丢失，而服用安慰剂者脊柱、前臂有明显的骨密度下降，但股骨头骨密度没有显著下降。（梅洁）"
                                }
                            ]
                        }
                    ],
                    "index": 4,
                    "merge_prev": false
                },
