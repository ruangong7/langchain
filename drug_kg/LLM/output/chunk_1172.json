    "relations": [
      {
        "id": "rel_1",
        "type": "HAS_MECHANISM",
        "source_id": "ent_12",
        "target_id": "ent_6",
        "name": "可逆性酶抑制作用为基础模型评估机制",
        "properties": {
          "evidence": {
            "chunk_index": 1172,
            "source": "凡默谷",
            "text": "针对可逆性酶抑制作用的基础模型计算公式为通过计算人体游离药物浓度（Imax,u）与药物体外抑制常数(Ki)的比值，推算在存在或不存在抑制剂的条件下合并使用其他药物的系统暴露量(AUC)预测比率(R)。"
          }
        }
      },
      {
        "id": "rel_2",
        "type": "HAS_MECHANISM",
        "source_id": "ent_12",
        "target_id": "ent_7",
        "name": "时间依赖性酶抑制作用为基础模型评估机制",
        "properties": {
          "evidence": {
            "chunk_index": 1172,
            "source": "凡默谷",
            "text": "对于时间依赖性酶抑制作用的评估较为复杂。由于酶失活引起酶功能的动态改变近似于一个简单的动态方程，基础模型参数包括了降解速率常数(Kdeg)，表观失活常数（KI)和最大失活速率(Kinact)，计算公式为此处当R值≥1.25，建议采用PBPK模型或开展临床DDI试验进一步评估药物相互作用的可能性。"
          }
        }
      },
      {
        "id": "rel_3",
        "type": "HAS_MECHANISM",
        "source_id": "ent_13",
        "target_id": "ent_8",
        "name": "代谢酶诱导剂通过诱导作用影响其他药物代谢",
        "properties": {
          "evidence": {
            "chunk_index": 1172,
            "source": "凡默谷",
            "text": "3.3 作为代谢酶诱导剂在伴随其他酶抑制作用时，如果仅检测酶的活性，可能掩盖酶诱导作用，因此推荐以底物探针的mRNA水平和/或酶活性作为检测指标评估酶诱导作用。"
          }
        }
      },
      {
        "id": "rel_4",
        "type": "IN_CLASS",
        "source_id": "ent_1",
        "target_id": "ent_13",
        "name": "CYP3A4属于代谢酶诱导剂相关酶",
        "properties": {
          "evidence": {
            "chunk_index": 1172,
            "source": "凡默谷",
            "text": "由于CYP3A和CYP2C酶诱导均依赖于孕甾烷X受体(pregnane X receptor, PXR)的活化，因此在研究起始阶段可仅评估药物对CYP1A2、CYP2B6、CYP3A4/ 5的作用，若CYP3A结果为阴性，可不必对CYP2C进行研究。"
          }
        }
