        "name": "地高辛与伊曲康唑相互作用",
        "properties": {
          "mechanism": "通过抑制P-糖蛋白",
          "consequence": "地高辛血药浓度升高，可能中毒",
          "recommendation": "应减少地高辛剂量，监测血浆浓度、药物作用及副作用",
          "evidence": {
            "chunk_index": 1416,
            "source": "医学资料库",
            "text": "在使用本品治疗期间需监测血浆浓度、药物作用及副作用的药物，当与伊曲康唑合用时，必要时应当减量：地高辛（通过抑制P-糖蛋白）。",
            "evidence_id": "ev_1"
          }
        }
      },
      {
        "id": "rel_2",
        "type": "INTERACTS_WITH",
        "source_id": "ent_1",
        "target_id": "ent_4",
        "name": "地高辛与奎尼丁相互作用",
        "properties": {
          "mechanism": "奎尼丁从组织结合处置换出地高辛，减少其分布容积",
          "consequence": "地高辛血药浓度提高约一倍，甚至达中毒浓度",
          "recommendation": "两药合用时应酌减地高辛用量1/2～1/3",
          "evidence": {
            "chunk_index": 1416,
            "source": "医学资料库",
            "text": "与奎尼丁同用，可使本品血药浓度提高约一倍，提高程度与奎尼丁用量相关，甚至可达到中毒浓度，即使停用地高辛，其血药浓度仍继续上升，这是奎尼丁从组织结合处置换出地高辛，减少其分布容积之故。两药合用时应酌减地高辛用量1/2～1/3。",
            "evidence_id": "ev_1"
          }
        }
      },
