      {
        "id": "rel_1",
        "type": "INTERACTS_WITH",
        "source_id": "ent_1",
        "target_id": "ent_2",
        "name": "氟西汀可引起美托洛尔的血药浓度升高，毒性增大",
        "properties": {
          "后果": [
            "毒性增大"
          ],
          "建议": "应注意监测，必要时减少美托洛尔的用量",
          "证据": {
            "chunk_index": 1334,
            "source": "医学分享俱乐部",
            "text": "氟西汀可引起美托洛尔的血药浓度升高，毒性增大，故应注意监测，必要时减少美托洛尔的用量。文献依据：卫生部合理用药专家委员会.中国医师药师临床用药指南[M].重庆:重庆出版集团,重庆出版社,2009.499～502."
          }
        }
      },
      {
        "id": "rel_2",
        "type": "INTERACTS_WITH",
        "source_id": "ent_3",
        "target_id": "ent_4",
        "name": "咪达唑仑与舒芬太尼同用可引起严重呼吸抑制及突然低血压",
        "properties": {
          "后果": [
            "严重呼吸抑制",
            "突然低血压"
          ],
          "建议": "应严密监测血药浓度，并且适当减少剂量",
          "证据": {
            "chunk_index": 1334,
            "source": "医学分享俱乐部",
            "text": "咪达唑仑与芬太尼或舒芬太尼同用，可引起严重呼吸抑制及突然低血压，因而这些药合用时应严密监测血药浓度，并且适当减少剂量。文献依据：《新编临床用药参考》"
          }
        }
      },
      {
        "id": "rel_3",
        "type": "INTERACTS_WITH",
        "source_id": "ent_5",
        "target_id": "ent_6",
        "name": "硝苯地平与镁合用可引起显著的低血压和神经肌肉阻滞",
        "properties": {
          "后果": [
            "显著的低血压",
            "神经肌肉阻滞"
          ],
          "建议": "合用时应密切监测血压",
          "证据": {
            "chunk_index": 1334,
            "source": "医学分享俱乐部",
            "text": "镁剂用于早产治疗时，如与本药合用可引起显著的低血压和神经肌肉阻滞。合用时应密切监测血压。文献依据：卫生部合理用药专家委员会.中国医师药师临床用药指南[M].重庆:重庆出版集团,重庆出版社,2009.577～580."
          }
        }
      },
      {
        "id": "rel_4",
        "type": "INTERACTS_WITH",
        "source_id": "ent_7",
        "target_id": "ent_8",
        "name": "诺氟沙星与茶碱合用导致茶碱血药浓度升高，出现中毒症状",
        "properties": {
          "机制": "与细胞色素P450结合部位的竞争性抑制",
          "后果": [
            "茶碱中毒症状"
          ],
          "症状列表": [
            "恶心",
            "呕吐",
            "震颤",
            "不安",
            "激动",
            "抽搐",
            "心悸"
          ],
          "建议": "应测定茶碱类血药浓度和调整剂量",
          "证据": {
            "chunk_index": 1334,
            "source": "医学分享俱乐部",
            "text": "诺氟沙星“与茶碱类合用时可能由于与细胞色素P450结合部位的竞争性抑制，导致茶碱类的肝清除明显减少，血消除半衰期(t1/2β)延长，血药浓度升高，出现茶碱中毒症状，如恶心、呕吐、震颤、不安、激动、抽搐、心悸等，故合用时应测定茶碱类血药浓度和调整剂量。”文献依据：SFDA药品说明书范本"
          }
        }
      },
