    "relations": [
      {
        "id": "rel_1",
        "type": "INTERACTS_WITH",
        "source_id": "ent_1",
        "target_id": "ent_2",
        "name": "别嘌醇与ACEI可能存在相互作用导致超敏反应",
        "properties": {
          "mechanism": "尚不明确",
          "outcome": "超敏反应、低白细胞计数",
          "severity": "罕见且不可预测",
          "recommendation": "密切监测任何超敏反应的体征（例如皮肤反应）或低白细胞计数（例如咽喉痛、发热），特别是当存在肾损害的时候；在ACEI服用期间加用别嘌醇前，应进行白细胞分类计数，并在治疗的前3个月，每2周检查一次，此后定期进行",
          "evidence": {
            "chunk_index": 1364,
            "source": "医学界内分泌频道",
            "text": "相互作用机制尚不明确。不确定上述不良反应是否为别嘌醇和ACEI的相互作用，因为别嘌醇和卡托普利单独给药也可引起超敏反应，尤其是在肾衰竭的情况下。虽然这种相互作用尚未明确，上述不良反应罕见且不可预测。仍建议服用两种药物的患者密切监测任何超敏反应的体征（例如皮肤反应）或低白细胞计数（例如咽喉痛、发热），特别是当存在肾损害的时候。英国卡托普利的生产商建议，在ACEI服用期间加用别嘌醇前，应进行白细胞分类计数，并在治疗的前3个月，每2周检查一次，此后定期进行[4]。英国其他几种ACEI的生产商也给出了类似的警告和建议"
          }
        }
