      {
        "id": "ev_1",
        "type": "Evidence",
        "name": "医脉通泌尿外科",
        "properties": {
          "chunk_id": "1524",
          "source": "医脉通泌尿外科",
          "text": "氟唑帕利通过CYP3A4代谢，地塞米松为CYP3A4强诱导剂，合用氟唑帕利代谢加快，疗效下降，故氟唑帕利说明书明确指出“临床用药中建议避免同时使用CYP3A4强诱导剂”。如临床上需使用地塞米松，应关注奥拉帕利疗效，必要时加大奥拉帕利剂量。"
        }
      },
      {
        "id": "ev_2",
        "type": "Evidence",
        "name": "医脉通泌尿外科",
        "properties": {
          "chunk_id": "1524",
          "source": "医脉通泌尿外科",
          "text": "阿瑞匹坦、奈妥吡坦为CYP3A4中效抑制剂，文献指出CYP3A4中效抑制剂氟康唑可使氟唑帕利Cmax、AUC0～t、AUC0～∞增加1～2倍，故建议氟唑帕利与CYP3A4中效抑制剂合用时减量至50 mg 2次/d。"
        }
      },
      {
        "id": "ev_3",
        "type": "Evidence",
        "name": "医脉通泌尿外科",
        "properties": {
          "chunk_id": "1524",
          "source": "医脉通泌尿外科",
          "text": "福沙匹坦为CYP3A4弱抑制剂，可能引起氟唑帕利不良反应增加，但影响程度较小，使用中应加强对氟唑帕利不良反应的关注。"
        }
      },
      {
        "id": "ev_4",
        "type": "Evidence",
        "name": "医脉通泌尿外科",
        "properties": {
          "chunk_id": "1524",
          "source": "医脉通泌尿外科",
          "text": "5-HT3受体拮抗剂、沙利度胺和氟唑帕利合用便秘和骨髓抑制风险增加，注意加强关注便秘和血常规。"
        }
      },
      {
        "id": "ev_5",
        "type": "Evidence",
        "name": "医脉通泌尿外科",
        "properties": {
          "chunk_id": "1524",
          "source": "医脉通泌尿外科",
          "text": "罗拉匹坦、奥氮平与氟唑帕利之间没有已知或机制上的相互作用，可以安全合用。"
        }
      },
      {
        "id": "ev_6",
        "type": "Evidence",
        "name": "医脉通泌尿外科",
        "properties": {
          "chunk_id": "1524",
          "source": "医脉通泌尿外科",
          "text": "甲氧氯普胺主要经CYP2D6、CYP3A4代谢，合用时与氟唑帕利竞争代谢酶CYP3A4，可能导致氟唑帕利代谢减慢，应加强对奥拉帕利不良反应的关注。"
        }
      },
      {
        "id": "ev_7",
        "type": "Evidence",
        "name": "医脉通泌尿外科",
        "properties": {
