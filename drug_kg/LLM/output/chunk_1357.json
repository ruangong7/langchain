    "relations": [
      {
        "id": "rel_1",
        "type": "INTERACTS_WITH",
        "source_id": "ent_1",
        "target_id": "ent_2",
        "name": "头孢与藿香正气水相互作用",
        "properties": {
          "机制": "头孢类药物抑制乙醛代谢，藿香正气水含乙醇，代谢为乙醛后蓄积",
          "后果": "双硫仑样反应，可致急性肝损害、呼吸暂停甚至死亡",
          "证据": {
            "chunk_index": 1357,
            "source": "医学界",
            "text": "藿香正气水中含有40~50%的乙醇，酒精在体内代谢产生乙醛，而头孢类药物会抑制乙醛在体内的代谢，造成乙醛蓄积，引起中毒，严重时可诱发急性肝损害、呼吸暂停甚至死亡。"
          }
        }
      },
      {
        "id": "rel_2",
        "type": "INTERACTS_WITH",
        "source_id": "ent_1",
        "target_id": "ent_3",
        "name": "头孢与乙醇相互作用",
        "properties": {
          "机制": "头孢类药物抑制乙醇代谢产生的乙醛进一步代谢",
          "后果": "乙醛蓄积，引发双硫仑样反应",
          "证据": {
            "chunk_index": 1357,
            "source": "医学界",
            "text": "藿香正气水中含有40~50%的乙醇，酒精在体内代谢产生乙醛，而头孢类药物会抑制乙醛在体内的代谢，造成乙醛蓄积，引起中毒，严重时可诱发急性肝损害、呼吸暂停甚至死亡。"
          }
        }
      },
      {
        "id": "rel_3",
        "type": "INTERACTS_WITH",
        "source_id": "ent_16",
        "target_id": "ent_3",
        "name": "甲硝唑与乙醇相互作用",
        "properties": {
          "机制": "甲硝唑抑制乙醇代谢",
          "后果": "双硫仑样反应",
          "证据": {
            "chunk_index": 1357,
            "source": "医学界",
            "text": "头孢类抗菌药、甲硝唑、替硝唑等药物，可抑制乙醇的代谢，引起“双硫仑样反应”，出现头痛、头晕、恶心、呕吐、心慌、胸闷、呼吸困难、血压下降等一系列症状。"
          }
        }
      },
