            "ent_16"
          ],
          "evidence": {
            "chunk_index": 1358,
            "source": "医学界",
            "text": "当西柚与降压药同服（如硝苯地平），会使药效增加几倍到几十倍，引起头晕恶心，比较危险。"
          }
        }
