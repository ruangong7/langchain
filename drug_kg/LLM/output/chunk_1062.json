      {
        "id": "rel_9",
        "type": "INTERACTS_WITH",
        "source_id": "ent_10",
        "target_id": "ent_1",
        "name": "姜黄素抑制P-gp的转运功能",
        "properties": {
          "机制": "姜黄素通过抑制ATP酶活性进而抑制P-gp的转运功能",
          "后果": "增加S562耐药细胞对多柔比星的敏感性，逆转获得性耐药",
          "证据": {
            "chunk_index": 1062,
            "source": "凡默谷",
            "text": "姜黄素通过抑制ATP酶活性进而抑制P-gp的转运功能，可明显增加S562耐药细胞对多柔比星的敏感性[60]。不仅如此，姜黄素还可显著抑制非小细胞肺癌NCL-H460细胞中P-gp的表达，降低细胞中多柔比星的外排，进而提高胞内蓄积率，有效逆转获得性耐药[61]。"
          }
        }
      },
      {
        "id": "rel_10",
        "type": "INTERACTS_WITH",
        "source_id": "ent_12",
        "target_id": "ent_11",
        "name": "PHn-7增强乳腺癌细胞对阿霉素的敏感性",
        "properties": {
          "机制": "PHn-7通过抑制P-gp表达和功能而逆转乳腺癌细胞对阿霉素的耐药性",
          "后果": "阿霉素的细胞毒性分别增加21.48%、86.47%和99.60%",
          "证据": {
            "chunk_index": 1062,
            "source": "凡默谷",
            "text": "而且PHn-7与阿霉素联合作用，可明显增强乳腺癌细胞对阿霉素的敏感性，0.5、1和2 pmol/L的PH n -7使阿霉素的细胞毒性分别增加 21.48%、86.47%和99.60%。在诱导凋亡同时，PH n -7可通过抑制P-gp表达和功能而逆转乳腺癌细胞对阿霉素的耐药性[62]"
          }
        }
