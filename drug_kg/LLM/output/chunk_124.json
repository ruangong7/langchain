      {
        "id": "rel_1",
        "type": "HAS_MECHANISM",
        "source_id": "ent_16",
        "target_id": "ent_10",
        "name": "在研药物抑制代谢酶",
        "properties": {
          "evidence": {
            "chunk_index": 124,
            "source": "GMP办公室",
            "text": "当静态机制模型或PBPK模型用于预测由于代谢酶活性被抑制引起的药物相互作用时，模型应仅包括抑制机制（即该模型预测不应该同时包括诱导和抑制两种机制）来确定所评估的在研药物抑制代谢酶的能力。"
          }
        }
