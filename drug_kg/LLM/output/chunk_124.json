        "name": "在研药物影响AUC",
        "properties": {
          "evidence": {
            "chunk_index": 124,
            "source": "GMP办公室",
            "text": "应计算预测存在和不存在抑制剂时指针底物AUC的预测比值R1。"
          }
        }
      },
      {
        "id": "rel_4",
        "type": "AFFECTS_INDICATOR",
        "source_id": "ent_16",
        "target_id": "ent_13",
        "name": "在研药物影响AUCR",
        "properties": {
          "evidence": {
            "chunk_index": 124,
            "source": "GMP办公室",
            "text": "如果根据静态或动态机制模型（例如PBPK模型）预测存在和不存在在研药物时敏感指针底物的AUC比值（AUCR）≥1.25，则应使用敏感指针底物开展临床药物相互作用研究。"
          }
        }
