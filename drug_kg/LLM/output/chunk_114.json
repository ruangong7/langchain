      {
        "id": "rel_1",
        "type": "INTERACTS_WITH",
        "source_id": "ent_2",
        "target_id": "ent_3",
        "name": "卡马西平与大环内酯类抗生素相互作用",
        "properties": {
          "mechanism": "",
          "effect": "使卡马西平血浓度升高，可出现毒性反应",
          "evidence": {
            "chunk_index": 114,
            "source": "E药汇",
            "text": "卡马西平缓释片“烟酰胺、抗抑郁药、大环内酯类抗生素、异烟肼、西咪替丁等药物均可使本品血浓度升高，可出现毒性反应。”文献依据：药品说明书范本"
          }
        }
      },
      {
        "id": "rel_2",
        "type": "INTERACTS_WITH",
        "source_id": "ent_2",
        "target_id": "ent_5",
        "name": "卡马西平与西咪替丁相互作用",
        "properties": {
          "mechanism": "",
          "effect": "西咪替丁可使卡马西平血药浓度升高，有导致药物过量的危险",
          "evidence": {
            "chunk_index": 114,
            "source": "E药汇",
            "text": "西咪替丁可使卡马西平、美沙酮、他克林的血药浓度升高，有导致药物过量的危险。文献依据：卫生部合理用药专家委员会.中国医师药师临床用药指南[M].重庆:重庆出版集团,重庆出版社,2009.711～714."
          }
        }
      },
      {
        "id": "rel_3",
        "type": "INTERACTS_WITH",
        "source_id": "ent_7",
        "target_id": "ent_8",
        "name": "环丙沙星与茶碱相互作用",
        "properties": {
          "mechanism": "与细胞色素P450结合部位的竞争性抑制",
          "effect": "茶碱肝消除明显减少，血消除半衰期延长，血药浓度升高，出现茶碱中毒症状",
          "evidence": {
            "chunk_index": 114,
            "source": "E药汇",
            "text": "环丙沙星与茶碱类合用时可能由于与细胞色素P450结合部位的竞争性抑制，导致茶碱类的肝消除明显减少，血消除半衰期(t1/2β)延长，血药浓度升高，出现茶碱中毒症状，如恶心、呕吐、震颤、不安、激动、抽搐、心悸等，故合用时应测定茶碱类血药浓度和调整剂量。文献依据：SFDA药品说明书范本"
          }
        }
      },
